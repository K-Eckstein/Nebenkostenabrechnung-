{
  "name": "sandbox-workspace",
  "version": "1.0.0",
  "description": "Nebenkostenabrechnung für Vermieter",
  "author": "Klaus",  
"private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "electron": "npm run build && electron .",
    "electron:build:linux": "npm run build && electron-builder --linux AppImage",
    "electron:build:win": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.nebenkosten.app",
    "productName": "Nebenkostenabrechnung",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Nebenkostenabrechnung-Portable.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "artifactName": "Nebenkostenabrechnung-${version}.AppImage"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.16.1",
    "html2canvas-pro": "^1.0.0",
    "html2pdf.js": "^0.10.3",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/html2pdf.js": "^0.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
